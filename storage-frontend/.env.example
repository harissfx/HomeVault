# Alamat backend storage-api. Untuk testing lokal, biarkan default.
# Nanti kalau backend sudah jalan lewat ngrok/Tailscale, ganti ke URL publiknya
# (atau cukup ganti langsung lewat tombol Pengaturan di UI tanpa deploy ulang).
VITE_API_URL=http://localhost:4000
VITE_API_KEY=isi-sama-dengan-API_KEY-di-backend
