# Port API jalan di sini (lokal di STB)
PORT=4000

# Token rahasia buat proteksi API - GANTI dengan string acak yang panjang
# Contoh bikin token acak: jalankan `openssl rand -hex 32` di terminal
API_KEY=ganti_dengan_token_rahasia_kamu

# Folder tempat file disimpan - arahkan ke mount point flashdisk 2 kamu
STORAGE_DIR=/mnt/usb2/storage

# Batas ukuran upload per file (MB)
MAX_FILE_SIZE_MB=500

# Domain frontend Vercel kamu, buat CORS (isi setelah deploy ke Vercel)
# Bisa lebih dari satu, pisahkan pakai koma
ALLOWED_ORIGINS=http://localhost:3000
